# Jangan pernah bake credential ke dalam image Docker.
# (env vars di-inject saat runtime lewat `env_file: .env` di docker-compose.yml)
.env
.env_wds
.env.example
.env_wds.example

# Git & version control
.git
.gitignore

# Python cache & virtual envs
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
openbb_env/
openbb_venv/
.aqt-venv/

# State/log yang sudah di-handle lewat volume, tidak perlu masuk image
logs/
paper_ledger.json
backtest_results.json
leaderboard.json

# Repo eksternal berat yang tidak dipakai runtime
FinceptTerminal/
OpenBB/
machine-learning-for-trading/

# Misc
.DS_Store
*.log
.obsidian/
