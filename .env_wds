# =============================================
# TradeProject Futures Trading - Environment (.env_wds)
# =============================================
# Copy file ini ke .env_wds dan isi dengan data Anda.
# JANGAN COMMIT file .env_wds ke git!

# --- Binance API Credentials ---
# Get from: Binance Dashboard → API Management → Create API
# Choose "System generated" (NOT self-generated)
# Must enable: ✅ Enable Trading
# Must NOT enable: ❌ Enable Withdrawals
# IP Whitelist: Add your public IP (see IP_SETUP_GUIDE.txt)
BINANCE_API_KEY=3ApzFQHqpiH7Lz4g4nHk6P6f83ZfWOy1UKmPgayYTn10j6lTOjj62mgHCm2SYCMl
BINANCE_SECRET_KEY=MRx7QSlIfqfSWTUk5KNs5UtFTYD4aNR9wre5UmzCvSBbJB05dyGhADLmMCcWsQ5s

# --- Execution Mode ---
# "PAPER_TRADING" = Simulation (no real orders)
# "LIVE_TRADING" = Real orders on Binance Futures
EXECUTION_MODE=PAPER_TRADING

# --- Binance Network ---
# true = Testnet (paper money, real futures data)
# false = Mainnet (real money, real futures)
BINANCE_SANDBOX=true

# --- Worker Settings ---
TICK_INTERVAL_SECONDS=30

# --- Your Public IP for Binance API Whitelist ---
# Find your public IP at: https://ifconfig.me
# For Railway, IP changes per-deploy. Use Railway's static IP
# or add 0.0.0.0/0 temporarily (less secure).
# For Windows terminal 24/7, whitelist your home/public IP.
YOUR_PUBLIC_IP=0.0.0.0/0

# --- Futures Settings ---
# Binance Futures Default Leverage (per symbol)
BTCUSDT_LEVERAGE=20
ETHUSDT_LEVERAGE=20
SOLUSDT_LEVERAGE=15
BNBUSDT_LEVERAGE=10
AVAXUSDT_LEVERAGE=10
# Margin Mode: "isolated" (recommended) or "cross"
MARGIN_MODE=isolated
